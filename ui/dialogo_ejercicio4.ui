  <property name="styleSheet">
   <string notr="true">/* --- Aplicar fuente global para que todo sea legible y moderno --- */
QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 13px; /* Tamaño base cómodo */
    color: #2D3748; /* Gris oscuro para el texto, evita fatiga visual */
}

/* --- Fondo de la ventana --- */
QMainWindow {
    background-color: #FAFAFA; /* Un blanco suave y profesional */
}

/* --- Etiquetas (Labels) --- */
QLabel {
    /* Mantiene tamaño, solo ajusta color y grosor ligero */
    font-weight: 500;
}

/* --- Destacar específicamente el resultado --- */
#lbl_resultado {
    /* Aquí forzamos que se vea claro y grande */
    font-size: 16px;
    font-weight: bold;
    color: #1A365D; /* Azul marino profundo */
    background-color: #EDF2F7; /* Un fondo gris azulado muy suave para resaltarlo */
    border-radius: 6px; /* Borde sutilmente redondeado */
    padding: 10px; /* Suficiente espacio alrededor del texto */
    border: 1px solid #E2E8F0; /* Borde fino para darle forma */
}

/* --- Cajas de entrada de texto (LineEdits) --- */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1; /* Borde gris claro */
    border-radius: 5px; /* Bordes redondeados sutiles */
    color: #334155;
    /* No tocamos padding para que respete el tamaño por defecto */
}

/* Estado de foco (cuando haces clic para escribir) */
QLineEdit:focus {
    border: 2px solid #3B82F6; /* Borde azul vibrante */
    background-color: #F8FAFC;
}

/* --- Botón de Calcular --- */
QPushButton {
    background-color: #2563EB; /* Azul profesional corporativo */
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 5px; /* Bordes redondeados sutiles */
    /* No tocamos padding ni min-height */
}

/* Efectos al interactuar con el botón */
QPushButton:hover {
    background-color: #1D4ED8; /* Azul un poco más oscuro al pasar el mouse */
}

QPushButton:pressed {
    background-color: #1E40AF; /* Azul aún más oscuro al presionar */
    border: 1px solid #1E40AF;
}</string>
